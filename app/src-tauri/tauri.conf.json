{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "AetherShare",
  "version": "0.2.3",
  "identifier": "org.aethershare.desktop",
  "build": {
    "frontendDist": "../ui/dist",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "npm --prefix ../ui run dev",
    "beforeBuildCommand": "npm --prefix ../ui run build"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "AetherShare",
        "width": 1120,
        "height": 740,
        "minWidth": 820,
        "minHeight": 580,
        "center": true,
        "resizable": true,
        "dragDropEnabled": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "rpm",
      "deb",
      "appimage"
    ],
    "icon": [
      "icons/icon.png"
    ],
    "category": "Utility",
    "publisher": "amarenyo",
    "homepage": "https://github.com/amarenyo/AetherShare",
    "shortDescription": "Open-Source Quick Share & AirDrop for Linux (Material 3 Expressive)",
    "linux": {
      "deb": {
        "depends": [
          "libwebkit2gtk-4.1-0",
          "libgtk-3-0",
          "libayatana-appindicator3-1",
          "bluez",
          "network-manager"
        ],
        "files": {
          "/usr/bin/aethershare": "../../target/release/aethershare",
          "/usr/libexec/aethershare/aethershare-awdld": "../../target/release/aethershare-awdld",
          "/usr/lib/systemd/system/aethershare-awdld.service": "../packaging/awdl/aethershare-awdld.service",
          "/usr/share/dbus-1/system.d/aethershare-awdld.conf": "../packaging/awdl/aethershare-awdld.conf",
          "/usr/share/dbus-1/system-services/io.github.t4t5.Owly.service": "../packaging/awdl/io.github.t4t5.Owly.service",
          "/usr/share/polkit-1/actions/aethershare-awdld.policy": "../packaging/awdl/aethershare-awdld.policy",
          "/usr/lib/NetworkManager/conf.d/90-aethershare-awdl.conf": "../packaging/awdl/90-aethershare-awdl.conf",
          "/usr/lib/systemd/network/10-aethershare-awdl0.link": "../packaging/awdl/10-aethershare-awdl0.link"
        },
        "postInstallScript": "../packaging/awdl/postinstall.sh",
        "postRemoveScript": "../packaging/awdl/postremove.sh"
      },
      "rpm": {
        "depends": [
          "webkit2gtk4.1",
          "gtk3",
          "libayatana-appindicator-gtk3",
          "bluez",
          "NetworkManager"
        ],
        "files": {
          "/usr/bin/aethershare": "../../target/release/aethershare",
          "/usr/libexec/aethershare/aethershare-awdld": "../../target/release/aethershare-awdld",
          "/usr/lib/systemd/system/aethershare-awdld.service": "../packaging/awdl/aethershare-awdld.service",
          "/usr/share/dbus-1/system.d/aethershare-awdld.conf": "../packaging/awdl/aethershare-awdld.conf",
          "/usr/share/dbus-1/system-services/io.github.t4t5.Owly.service": "../packaging/awdl/io.github.t4t5.Owly.service",
          "/usr/share/polkit-1/actions/aethershare-awdld.policy": "../packaging/awdl/aethershare-awdld.policy",
          "/usr/lib/NetworkManager/conf.d/90-aethershare-awdl.conf": "../packaging/awdl/90-aethershare-awdl.conf",
          "/usr/lib/systemd/network/10-aethershare-awdl0.link": "../packaging/awdl/10-aethershare-awdl0.link"
        },
        "postInstallScript": "../packaging/awdl/postinstall.sh",
        "postRemoveScript": "../packaging/awdl/postremove.sh"
      }
    }
  }
}
