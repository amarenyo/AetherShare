[Unit]
Description=AetherShare AWDL radio service (powered by Owly)
Documentation=https://github.com/amarenyo/AetherShare
After=dbus.service NetworkManager.service
Wants=sys-kernel-debug.mount
After=sys-kernel-debug.mount

[Service]
Type=dbus
BusName=io.github.t4t5.Owly
ExecStart=/usr/libexec/aethershare/aethershare-awdld
Restart=on-failure

RuntimeDirectory=owly
RuntimeDirectoryPreserve=yes
RuntimeDirectoryMode=0755

CapabilityBoundingSet=CAP_NET_ADMIN CAP_NET_RAW
AmbientCapabilities=CAP_NET_ADMIN CAP_NET_RAW
NoNewPrivileges=yes

ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
ProtectProc=invisible
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallErrorNumber=EPERM
RestrictAddressFamilies=AF_UNIX AF_NETLINK AF_PACKET AF_INET AF_INET6
DevicePolicy=closed
DeviceAllow=/dev/net/tun rw

[Install]
WantedBy=multi-user.target
